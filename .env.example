# Copy this file to .env and customize values for your local environment.
# The .env file is ignored by git.

# Required workspace paths
PUDL_INPUT=/absolute/path/to/pudl-input
PUDL_OUTPUT=/absolute/path/to/pudl-output
DAGSTER_HOME=/absolute/path/to/dagster-home

# Logging controls (read by pudl.logging_helpers.configure_root_logger)
PUDL_LOGLEVEL=INFO
PUDL_COLOR_LOGS=true

# Optional: force PUDL to run the full ferc_to_sqlite conversion process even if there
# is a compatible DB cached either locally or in nightly builds.
PUDL_FORCE_FERC_TO_SQLITE=true

# Optional: nonstandard path to FERC EQR input data archive.
# Useful for working with local EQR data in development
PUDL_FERCEQR_ARCHIVE_PATH=/abs/path/to/ferceqr/zipfile/dir

# Optional: path to a file that specifies FERC EQR deployment targets.
# If unset, local development will skip FERC EQR deployment.
# Production batch runs should point this at the packaged config file inside the repo.
# To test deployment without touching cloud buckets, write your own YAML file with a
# local directory as the target (the directory must already exist), e.g.:
#   deployment_targets:
#     - path: /absolute/path/to/pudl-output/ferceqr_deployment/ferceqr
PUDL_FERCEQR_DEPLOYMENT_CONFIG_PATH=/absolute/path/to/ferceqr_deployment_targets.yml

# Optional: directory of Parquet files for dbt to validate, instead of
# $PUDL_OUTPUT/parquet. Set by `dbt_helper validate --parquet-base-path`; useful for
# checking a remote nightly build or another worktree's outputs.
PARQUET_BASE_PATH=/absolute/path/to/parquet

# Optional: cap each DuckDB connection (see pudl.helpers.duckdb_connect). Unset, DuckDB
# uses every core and ~80% of RAM, which oversubscribes the machine when many
# DuckDB-backed assets run at once (e.g. a FERC EQR partition backfill). DuckDB spills
# to the temp directory rather than failing when the memory limit is hit.
PUDL_DUCKDB_THREADS=2
PUDL_DUCKDB_MEMORY_LIMIT=4GB
PUDL_DUCKDB_TEMP_DIRECTORY=/absolute/path/to/duckdb-tmp

# Optional: identifier for a batch build. Names the FERC EQR deployment staging
# prefix (random if unset) and is appended to targets with append_build_id enabled,
# which raise an error if it's missing.
BUILD_ID=local-test

# Optional: Zulip bot API key used for build and deployment notifications. The FERC
# EQR deployment resource reads it at launch, so set a dummy value for local runs.
ZULIP_API_KEY=dummy

# Optional: required for devcontainer to work correctly.
PUDL_ROOT_PATH=/absolute/path/to/pudl/repo

# Optional: set the number of threads to use for parallel processing in numpy.
# This affects how CPU intensive our timeseries imputation is.
OMP_NUM_THREADS=4

# Optional: write logs to a file in addition to console output.
# Leave unset for console-only logging.
PUDL_LOGFILE=/absolute/path/to/pudl/logs/pudl.log

# Optional: don't try and use intersphinx to link to external documentation
# during the docs build -- it can be flaky and isn't required for most docs edits.
# Ready by docs/conf.py
PUDL_DOCS_DISABLE_INTERSPHINX=1

# Optional: don't remove generated rst files after the docs build. Can be helpful
# when debugging formatting errors. Ready by docs/conf.py
PUDL_DOCS_KEEP_GENERATED_FILES=1
