@article{gaffney_science_2025,
    title = {Science {Data} {May} {Soon} {Vanish} {From} {Government} {Websites}},
	url = {https://www.nytimes.com/2025/03/21/climate/government-websites-climate-environment-data.html},
	abstract = {Austyn Gaffney reports that hundreds of terabytes of government climate, environmental, and energy resources have been taken offline under the Trump administration. Often the underlying data still exists, but the public tools for using it have been removed. Volunteers with the Public Environmental Data Partners coalition have retrieved more than 100 datasets and rebuilt tools such as CEJST and EJScreen. Catalyst Cooperative, a coalition member, has spent eight years aggregating U.S. energy system data into open-source tools to make federal data easier to use. Cofounder Christina Gosnell warns that preserved datasets could become irrelevant if data collection stops. Cofounder Zane Selvans notes that energy data has so far been spared, unlike environmental justice data.},
	journal = {The New York Times},
	author = {Gaffney, Austyn},
	month = mar,
	year = {2025},
}

