@article{mulligan_inside_2025,
    title = {Inside the race to archive the {US} government’s websites},
	url = {https://www.technologyreview.com/2025/02/07/1111328/inside-the-race-to-archive-the-us-governments-websites/},
	abstract = {Scott J. Mulligan reports on nonpartisan groups racing to save government data after the new US administration took down thousands of federal web pages. These groups include Catalyst Cooperative, which is part of the Public Environmental Data Partners, a collective dedicated to preserving federal environmental data. The article mentions technical obstacles to archiving data such as logins, captchas, and inconsistent site structures. Christina Gosnell warns that archiving is "a temporary Band-Aid", because data that stops being updated will grow stale.},
	journal = {MIT Technology Review},
	author = {Mulligan, Scott J.},
	month = feb,
	year = {2025},
}

@misc{aditya_am_interview_2025,
	type = {Interview},
	title = {Interview with {Priya} {Donti}, {Co}-founder and {Chair}, {Climate} {Change} {AI}},
	url = {https://aitimejournal.com/interview-with-priya-donti-co-founder-and-chair-climate-change-ai},
	abstract = {Priya Donti, Co-founder and Chair of Climate Change AI, describes how machine learning can support climate action, such as estimating emissions from satellite imagery and integrating renewables into power systems. She also warns that it can raise emissions or deepen inequities. She names the main barriers: limited funding and expertise among partners, applications that can't make money in current markets, and data that is fragmented or private. She calls for open-data efforts, including the Public Utility Data Liberation project, and for developing projects with stakeholders. Her conclusion is that AI is one tool among many, not a cure-all.},
	language = {en},
	urldate = {2026-10-15},
	journal = {AI Time Journal},
	author = {{Aditya A.M.}},
	month = nov,
	year = {2025},
}

